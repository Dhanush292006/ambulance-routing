<?xml version="1.0"?>
<sdf version="1.9">

  <world name="smart_city">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <!-- Publish scene / entity state so the Gazebo GUI can render the world. -->
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="default_physics" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.55 0.65 0.75 1</background>
      <shadows>false</shadows>
    </scene>



    <!-- ================================================= -->
    <!-- MAIN ROAD NETWORK                                 -->
    <!-- ================================================= -->

    <model name="main_road">
      <static>true</static>
      <link name="road">
        <visual name="asphalt">
          <pose>70 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>160 14 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.07 0.07 0.07 1</ambient>
            <diffuse>0.07 0.07 0.07 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- NORTH ALTERNATIVE ROAD -->
    <model name="north_road">
      <static>true</static>
      <link name="road">
        <visual name="asphalt">
          <pose>70 30 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>160 10 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.09 0.09 0.09 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- SOUTH ALTERNATIVE ROAD -->
    <model name="south_road">
      <static>true</static>
      <link name="road">
        <visual name="asphalt">
          <pose>70 -30 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>160 10 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.09 0.09 0.09 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- NORTH CONNECTORS -->
    <model name="north_connector_1">
      <static>true</static>
      <link name="road">
        <visual name="road_visual">
          <pose>25 15 0.02 0 0 1.5708</pose>
          <geometry>
            <box>
              <size>30 8 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.09 0.09 0.09 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_connector_2">
      <static>true</static>
      <link name="road">
        <visual name="road_visual">
          <pose>90 15 0.02 0 0 1.5708</pose>
          <geometry>
            <box>
              <size>30 8 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.09 0.09 0.09 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- SOUTH CONNECTORS -->
    <model name="south_connector_1">
      <static>true</static>
      <link name="road">
        <visual name="road_visual">
          <pose>25 -15 0.02 0 0 1.5708</pose>
          <geometry>
            <box>
              <size>30 8 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.09 0.09 0.09 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_connector_2">
      <static>true</static>
      <link name="road">
        <visual name="road_visual">
          <pose>90 -15 0.02 0 0 1.5708</pose>
          <geometry>
            <box>
              <size>30 8 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.09 0.09 0.09 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- HOSPITAL                                          -->
    <!-- ================================================= -->

    <model name="hospital">
      <static>true</static>
      <pose>140 30 5 0 0 0</pose>

      <link name="building">

        <collision name="collision">
          <geometry>
            <box>
              <size>30 22 10</size>
            </box>
          </geometry>
        </collision>

        <visual name="building">
          <geometry>
            <box>
              <size>30 22 10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.85 0.9 1</ambient>
            <diffuse>0.8 0.85 0.9 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- HOSPITAL HELIPAD -->
    <model name="helipad">
      <static>true</static>
      <pose>140 17 0.08 0 0 0</pose>
      <link name="pad">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>8</radius>
              <length>0.15</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- EMERGENCY STATION                                 -->
    <!-- ================================================= -->

    <model name="emergency_station">
      <static>true</static>
      <pose>-15 -18 3 0 0 0</pose>

      <link name="building">
        <collision name="collision">
          <geometry>
            <box>
              <size>24 18 6</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>24 18 6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.08 0.05 1</ambient>
            <diffuse>0.65 0.08 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- CITY BUILDINGS                                    -->
    <!-- ================================================= -->

    <model name="building_1">
      <static>true</static>
      <pose>20 45 7 0 0 0</pose>
      <link name="building">
        <visual name="v">
          <geometry>
            <box><size>18 18 14</size></box>
          </geometry>
          <material>
            <ambient>0.35 0.42 0.48 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="building_2">
      <static>true</static>
      <pose>50 45 10 0 0 0</pose>
      <link name="building">
        <visual name="v">
          <geometry>
            <box><size>20 20 20</size></box>
          </geometry>
          <material>
            <ambient>0.45 0.5 0.55 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="building_3">
      <static>true</static>
      <pose>85 45 6 0 0 0</pose>
      <link name="building">
        <visual name="v">
          <geometry>
            <box><size>22 18 12</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.46 0.5 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="building_4">
      <static>true</static>
      <pose>115 -45 8 0 0 0</pose>
      <link name="building">
        <visual name="v">
          <geometry>
            <box><size>20 20 16</size></box>
          </geometry>
          <material>
            <ambient>0.42 0.45 0.5 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- CRITICAL ROADBLOCK                                -->
    <!-- ================================================= -->

    <model name="roadblock_vehicle">
      <static>true</static>
      <pose>90 0 1 0 0 0</pose>

      <link name="vehicle">

        <collision name="collision">
          <geometry>
            <box>
              <size>5.5 5.0 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="vehicle">
          <geometry>
            <box>
              <size>5.5 5.0 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- ROADBLOCK CONES -->

    <model name="cone_1">
      <static>true</static>
      <pose>84 -4 0.5 0 0 0</pose>
      <link name="cone">
        <visual name="v">
          <geometry>
            <cone>
              <radius>0.5</radius>
              <length>1</length>
            </cone>
          </geometry>
          <material>
            <ambient>1 0.3 0 1</ambient>
            <diffuse>1 0.3 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cone_2">
      <static>true</static>
      <pose>88 -4 0.5 0 0 0</pose>
      <link name="cone">
        <visual name="v">
          <geometry>
            <cone>
              <radius>0.5</radius>
              <length>1</length>
            </cone>
          </geometry>
          <material>
            <ambient>1 0.3 0 1</ambient>
            <diffuse>1 0.3 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cone_3">
      <static>true</static>
      <pose>92 -4 0.5 0 0 0</pose>
      <link name="cone">
        <visual name="v">
          <geometry>
            <cone>
              <radius>0.5</radius>
              <length>1</length>
            </cone>
          </geometry>
          <material>
            <ambient>1 0.3 0 1</ambient>
            <diffuse>1 0.3 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- STREET LIGHTS                                     -->
    <!-- ================================================= -->

    <model name="street_light_1">
      <static>true</static>
      <pose>20 8 4 0 0 0</pose>
      <link name="pole">
        <visual name="pole">
          <geometry>
            <cylinder>
              <radius>0.12</radius>
              <length>8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="street_light_2">
      <static>true</static>
      <pose>60 8 4 0 0 0</pose>
      <link name="pole">
        <visual name="pole">
          <geometry>
            <cylinder>
              <radius>0.12</radius>
              <length>8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="street_light_3">
      <static>true</static>
      <pose>120 8 4 0 0 0</pose>
      <link name="pole">
        <visual name="pole">
          <geometry>
            <cylinder>
              <radius>0.12</radius>
              <length>8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
          </material>
        </visual>
      </link>
    </model>


    <!-- Lit ground slab keeps the road grid visible when viewed from any angle. -->
    <model name="city_ground">
      <static>true</static>
      <pose>70 0 -0.05 0 0 0</pose>
      <link name="ground">
        <collision name="collision"><geometry><box><size>1500 1000 0.1</size></box></geometry></collision>
        <visual name="pavement"><geometry><box><size>1500 1000 0.1</size></box></geometry>
          <material><ambient>0.24 0.29 0.24 1</ambient><diffuse>0.24 0.29 0.24 1</diffuse></material>
        </visual>
      </link>
    </model>
    <light name="city_sun" type="directional">
      <pose>0 0 100 0 0 0</pose><cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.88 0.82 1</diffuse><specular>0.25 0.25 0.25 1</specular>
      <direction>-0.35 0.25 -0.9</direction>
      <attenuation><range>500</range><constant>0.8</constant><linear>0.001</linear><quadratic>0.0001</quadratic></attenuation>
    </light>

    <!-- Broken lane dividers and road edges make the three corridors legible. -->
    <model name="road_markings"><static>true</static><link name="paint">
      <visual name="dash_p0_4"><pose>4 0 0.075 0 0 0</pose><geometry><box><size>6 0.22 0.01</size></box></geometry><material><ambient>0.88 0.82 0.58 1</ambient><diffuse>0.88 0.82 0.58 1</diffuse></material></visual>
