<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="smart_emergency_city">
    <physics name="1ms" type="gz-physics-dartsim-plugin"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>
    <gravity>0 0 -9.8</gravity><scene><ambient>1 1 1 1</ambient><background>.82 .90 1 1</background><shadows>true</shadows></scene>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 50 0 0 0</pose><diffuse>1 1 1 1</diffuse><specular>.6 .6 .6 1</specular><direction>-0.5 0.1 -0.9</direction></light>
    <light type="point" name="emergency_station_floodlight"><pose>0 0 12 0 0 0</pose><diffuse>1 1 1 1</diffuse><specular>.8 .8 .8 1</specular><attenuation><range>60</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation></light>
    <model name="city_ground"><static>true</static><link name="link"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>260 190</size></plane></geometry></collision><visual name="v"><geometry><plane><normal>0 0 1</normal><size>260 190</size></plane></geometry><material><ambient>.76 .78 .77 1</ambient><diffuse>.76 .78 .77 1</diffuse></material></visual></link></model>
    <!-- Four alternative urban corridors. -->
    <model name="central_arterial"><static>true</static><link name="link"><visual name="road"><pose>72 0 .03 0 0 0</pose><geometry><box><size>168 14 .08</size></box></geometry><material><ambient>.62 .64 .68 1</ambient><diffuse>.62 .64 .68 1</diffuse></material></visual><visual name="centre_line"><pose>72 0 .08 0 0 0</pose><geometry><box><size>168 .22 .02</size></box></geometry><material><emissive>.85 .75 .10 1</emissive></material></visual></link></model>
    <model name="north_bypass"><static>true</static><link name="link"><visual name="road"><pose>75 32 .03 0 0 0</pose><geometry><box><size>125 12 .08</size></box></geometry><material><ambient>.62 .64 .68 1</ambient><diffuse>.62 .64 .68 1</diffuse></material></visual></link></model>
    <model name="south_bypass"><static>true</static><link name="link"><visual name="road"><pose>78 -30 .03 0 0 0</pose><geometry><box><size>125 12 .08</size></box></geometry><material><ambient>.62 .64 .68 1</ambient><diffuse>.62 .64 .68 1</diffuse></material></visual></link></model>
    <model name="station_connector"><static>true</static><link name="link"><visual name="road"><pose>0 -13 .03 0 0 .58</pose><geometry><box><size>54 11 .08</size></box></geometry><material><ambient>.06 .06 .07 1</ambient></material></visual></link></model>
    <model name="north_connector"><static>true</static><link name="link"><visual name="road"><pose>31 16 .03 0 0 1.05</pose><geometry><box><size>47 10 .08</size></box></geometry><material><ambient>.06 .06 .07 1</ambient></material></visual></link></model>
    <model name="south_connector"><static>true</static><link name="link"><visual name="road"><pose>35 -16 .03 0 0 -.93</pose><geometry><box><size>43 10 .08</size></box></geometry><material><ambient>.06 .06 .07 1</ambient></material></visual></link></model>
    <!-- hospital, emergency station and city districts -->
    <model name="hospital_emergency_entrance"><static>true</static><pose>147 17 8 0 0 0</pose><link name="link"><visual name="hospital"><geometry><box><size>30 28 16</size></box></geometry><material><ambient>.75 .80 .86 1</ambient></material></visual><visual name="red_canopy"><pose>-1 -15 -3 0 0 0</pose><geometry><box><size>15 3 2</size></box></geometry><material><emissive>.8 .03 .03 1</emissive></material></visual></link></model>
    <model name="ambulance_station"><static>true</static><pose>-19 -17 5 0 0 0</pose><link name="link"><visual name="station"><geometry><box><size>26 20 10</size></box></geometry><material><ambient>.70 .14 .12 1</ambient></material></visual></link></model>
    <model name="residential_block"><static>true</static><pose>36 55 12 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>44 35 24</size></box></geometry><material><ambient>.70 .52 .38 1</ambient></material></visual></link></model>
    <model name="commercial_block"><static>true</static><pose>84 58 16 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>42 32 32</size></box></geometry><material><ambient>.28 .47 .67 1</ambient></material></visual></link></model>
    <model name="office_block"><static>true</static><pose>118 -57 19 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>40 30 38</size></box></geometry><material><ambient>.36 .38 .46 1</ambient></material></visual></link></model>
    <model name="parking"><static>true</static><pose>76 -51 .05 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>42 20 .1</size></box></geometry><material><ambient>.12 .12 .13 1</ambient></material></visual></link></model>
    <!-- Signal heads represent the green-corridor-controlled intersections. -->
    <model name="signal_A"><static>true</static><pose>35 8 4 0 0 0</pose><link name="link"><visual name="pole"><geometry><cylinder><radius>.18</radius><length>8</length></cylinder></geometry></visual><visual name="red"><pose>0 0 2.8 0 0 0</pose><geometry><sphere><radius>.38</radius></sphere></geometry><material><emissive>.9 .02 .02 1</emissive></material></visual></link></model>
    <model name="signal_B"><static>true</static><pose>72 8 4 0 0 0</pose><link name="link"><visual name="pole"><geometry><cylinder><radius>.18</radius><length>8</length></cylinder></geometry></visual><visual name="green"><pose>0 0 2.0 0 0 0</pose><geometry><sphere><radius>.38</radius></sphere></geometry><material><emissive>.02 .9 .08 1</emissive></material></visual></link></model>
    <model name="signal_C"><static>true</static><pose>108 8 4 0 0 0</pose><link name="link"><visual name="pole"><geometry><cylinder><radius>.18</radius><length>8</length></cylinder></geometry></visual><visual name="yellow"><pose>0 0 2.4 0 0 0</pose><geometry><sphere><radius>.38</radius></sphere></geometry><material><emissive>.9 .7 .02 1</emissive></material></visual></link></model>
    <!-- Ambulance sensor topics are native Gazebo topics bridged by ros_gz_bridge when required. -->
    <model name="ambulance_01"><pose>0 0 1.25 0 0 0</pose><static>false</static><self_collide>false</self_collide><link name="base_link"><inertial><mass>2300</mass><inertia><ixx>1500</ixx><iyy>4500</iyy><izz>5000</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="body"><geometry><box><size>4.9 2.1 1.9</size></box></geometry></collision><visual name="white_body"><geometry><box><size>4.9 2.1 1.9</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual><visual name="red_stripe_left"><pose>0 -1.07 0 0 0 0</pose><geometry><box><size>4.5 .04 .36</size></box></geometry><material><ambient>.85 .02 .02 1</ambient><diffuse>.85 .02 .02 1</diffuse></material></visual><visual name="red_stripe_right"><pose>0 1.07 0 0 0 0</pose><geometry><box><size>4.5 .04 .36</size></box></geometry><material><ambient>.85 .02 .02 1</ambient><diffuse>.85 .02 .02 1</diffuse></material></visual><visual name="blue_beacon"><pose>.35 0 1.05 0 0 0</pose><geometry><box><size>.45 1.1 .18</size></box></geometry><material><emissive>.02 .08 1 1</emissive></material></visual><sensor name="lidar" type="gpu_lidar"><pose>1.7 0 1.1 0 0 0</pose><topic>/ambulance/scan</topic><update_rate>10</update_rate><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14</min_angle><max_angle>3.14</max_angle></horizontal></scan><range><min>.15</min><max>60</max><resolution>.01</resolution></range></lidar></sensor><sensor name="camera" type="camera"><pose>2.35 0 .45 0 0 0</pose><topic>/ambulance/camera/image_raw</topic><update_rate>15</update_rate><camera><horizontal_fov>1.57</horizontal_fov><image><width>800</width><height>450</height><format>R8G8B8</format></image><clip><near>.1</near><far>80</far></clip></camera></sensor><sensor name="imu" type="imu"><topic>/ambulance/imu</topic><update_rate>50</update_rate></sensor><sensor name="gps" type="navsat"><topic>/ambulance/gps</topic><update_rate>5</update_rate></sensor></link><link name="left_wheel"><pose>0 1.05 -.68 1.5708 0 0</pose><collision name="c"><geometry><cylinder><radius>.42</radius><length>.25</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>.42</radius><length>.25</length></cylinder></geometry><material><ambient>.04 .04 .04 1</ambient></material></visual></link><link name="right_wheel"><pose>0 -1.05 -.68 1.5708 0 0</pose><collision name="c"><geometry><cylinder><radius>.42</radius><length>.25</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>.42</radius><length>.25</length></cylinder></geometry><material><ambient>.04 .04 .04 1</ambient></material></visual></link><joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint><joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint><plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>2.1</wheel_separation><wheel_radius>.42</wheel_radius><topic>/ambulance/cmd_vel</topic><odom_topic>/ambulance/odom</odom_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id></plugin></model>
    <model name="bus_01"><static>true</static><pose>74 3 1.4 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>11 2.5 2.8</size></box></geometry><material><ambient>.12 .35 .86 1</ambient></material></visual><collision name="c"><geometry><box><size>11 2.5 2.8</size></box></geometry></collision></link></model>
    <model name="roadblock_vehicle"><static>true</static><pose>90 0 1 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>4.3 1.9 1.8</size></box></geometry><material><ambient>.25 .25 .25 1</ambient></material></visual><collision name="c"><geometry><box><size>4.3 1.9 1.8</size></box></geometry></collision></link></model>
    <model name="construction_zone"><static>true</static><pose>108 -4 .6 0 0 0</pose><link name="link"><visual name="barrier"><geometry><box><size>12 1 1.2</size></box></geometry><material><ambient>.95 .45 .02 1</ambient></material></visual></link></model>
    <!-- LiDAR-visible emergency obstruction: cones and barrier force a local replan. -->
    <model name="replan_barrier"><static>true</static><pose>90 0 .75 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>7 1.1 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>7 1.1 1.5</size></box></geometry><material><ambient>1 .35 .02 1</ambient><diffuse>1 .35 .02 1</diffuse></material></visual></link></model>
    <model name="traffic_cone_1"><static>true</static><pose>86 -2 .45 0 0 0</pose><link name="link"><collision name="c"><geometry><cone><radius>.45</radius><length>.9</length></cone></geometry></collision><visual name="v"><geometry><cone><radius>.45</radius><length>.9</length></cone></geometry><material><ambient>1 .3 .01 1</ambient><diffuse>1 .3 .01 1</diffuse></material></visual></link></model>
    <model name="traffic_cone_2"><static>true</static><pose>88 -2 .45 0 0 0</pose><link name="link"><collision name="c"><geometry><cone><radius>.45</radius><length>.9</length></cone></geometry></collision><visual name="v"><geometry><cone><radius>.45</radius><length>.9</length></cone></geometry><material><ambient>1 .3 .01 1</ambient><diffuse>1 .3 .01 1</diffuse></material></visual></link></model>
    <model name="traffic_cone_3"><static>true</static><pose>92 -2 .45 0 0 0</pose><link name="link"><collision name="c"><geometry><cone><radius>.45</radius><length>.9</length></cone></geometry></collision><visual name="v"><geometry><cone><radius>.45</radius><length>.9</length></cone></geometry><material><ambient>1 .3 .01 1</ambient><diffuse>1 .3 .01 1</diffuse></material></visual></link></model>
  </world>
</sdf>
