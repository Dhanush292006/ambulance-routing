    <!-- ROS/Nav2 controlled ambulance. Odometry, cmd_vel and lidar feed the live dashboard. -->
    <model name="ambulance">
      <pose>0 0 0 0 0 0</pose>
      <link name="base_link">
        <pose>0 0 0.72 0 0 0</pose>
        <inertial><mass>85</mass><inertia><ixx>32</ixx><iyy>80</iyy><izz>88</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="chassis_collision"><geometry><box><size>4.8 2.15 1.20</size></box></geometry></collision>
        <visual name="white_ambulance_body"><geometry><box><size>4.8 2.15 1.20</size></box></geometry><material><ambient>0.94 0.94 0.90 1</ambient><diffuse>0.94 0.94 0.90 1</diffuse></material></visual>
        <visual name="patient_cabin"><pose>-0.25 0 0.72 0 0 0</pose><geometry><box><size>2.7 1.98 0.72</size></box></geometry><material><ambient>0.18 0.34 0.43 1</ambient><diffuse>0.18 0.34 0.43 1</diffuse></material></visual>
        <visual name="red_side_stripe"><pose>0 1.09 -0.05 0 0 0</pose><geometry><box><size>3.8 0.04 0.24</size></box></geometry><material><ambient>0.88 0.025 0.02 1</ambient><diffuse>0.88 0.025 0.02 1</diffuse></material></visual>
        <visual name="red_roof_cross_long"><pose>0 0 0.99 0 0 0</pose><geometry><box><size>1.35 0.30 0.08</size></box></geometry><material><ambient>0.90 0.02 0.02 1</ambient><diffuse>0.90 0.02 0.02 1</diffuse></material></visual>
        <visual name="red_roof_cross_wide"><pose>0 0 0.99 0 0 0</pose><geometry><box><size>0.30 1.35 0.08</size></box></geometry><material><ambient>0.90 0.02 0.02 1</ambient><diffuse>0.90 0.02 0.02 1</diffuse></material></visual>
        <visual name="blue_lightbar"><pose>0 0 1.15 0 0 0</pose><geometry><box><size>0.85 0.38 0.16</size></box></geometry><material><ambient>0.02 0.16 0.95 1</ambient><diffuse>0.02 0.16 0.95 1</diffuse><emissive>0.02 0.08 0.65 1</emissive></material></visual>
        <sensor name="front_lidar" type="gpu_lidar">
          <pose>0.7 0 0.75 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize><topic>/ambulance/scan</topic>
          <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>18.0</max><resolution>0.02</resolution></range></lidar>
        </sensor>
      </link>
      <link name="left_wheel">
        <pose>0 0.94 0.36 0 0 0</pose><inertial><mass>4</mass><inertia><ixx>0.12</ixx><iyy>0.12</iyy><izz>0.12</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="wheel_collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.36</radius><length>0.18</length></cylinder></geometry><surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface></collision>
        <visual name="wheel"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.36</radius><length>0.18</length></cylinder></geometry><material><ambient>0.04 0.04 0.045 1</ambient><diffuse>0.04 0.04 0.045 1</diffuse></material></visual>
      </link>
      <link name="right_wheel">
        <pose>0 -0.94 0.36 0 0 0</pose><inertial><mass>4</mass><inertia><ixx>0.12</ixx><iyy>0.12</iyy><izz>0.12</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="wheel_collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.36</radius><length>0.18</length></cylinder></geometry><surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface></collision>
        <visual name="wheel"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.36</radius><length>0.18</length></cylinder></geometry><material><ambient>0.04 0.04 0.045 1</ambient><diffuse>0.04 0.04 0.045 1</diffuse></material></visual>
      </link>
      <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>1.88</wheel_separation><wheel_radius>0.36</wheel_radius>
        <topic>/ambulance/cmd_vel</topic><odom_topic>/ambulance/odom</odom_topic><frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <!-- Autonomous visual drive loop on the main and north roads. -->
      <plugin filename="gz-sim-trajectory-follower-system" name="gz::sim::systems::TrajectoryFollower">
        <link_name>base_link</link_name><loop>true</loop><range_tolerance>3.0</range_tolerance><bearing_tolerance>8.0</bearing_tolerance><force>180</force><torque>220</torque><waypoints>
          <waypoint>120 0</waypoint><waypoint>120 30</waypoint><waypoint>20 30</waypoint><waypoint>20 0</waypoint>
        </waypoints>
      </plugin>
    </model>

