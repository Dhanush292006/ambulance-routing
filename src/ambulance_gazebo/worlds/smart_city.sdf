    <!-- Mixed-use blocks on both sides of the road grid, with simple window panels. -->
    <model name="city_block_01"><static>true</static><pose>8 52 0 0 0 0</pose><link name="building">
      <visual name="facade"><pose>0 0 6.0 0 0 0</pose><geometry><box><size>16 15 12</size></box></geometry><material><ambient>0.42 0.48 0.52 1</ambient><diffuse>0.42 0.48 0.52 1</diffuse></material></visual>
      <visual name="window_0_-512"><pose>-5.12 -7.525 2.00 0 0 0</pose><geometry><box><size>2.2 0.08 1.7</size></box></geometry><material><ambient>0.22 0.60 0.76 1</ambient><diffuse>0.22 0.60 0.76 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
